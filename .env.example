# --- Required ----------------------------------------------------------------------

# Public URL of Plekstender as users open it (Plex redirects back here after sign-in).
APP_URL=http://localhost:8080
# Long random secret. Encrypts stored Plex tokens; changing it signs everyone out.
# Generate with: openssl rand -hex 32
APP_SECRET_KEY=
# Database password (generate with: openssl rand -hex 24)
POSTGRES_PASSWORD=

# --- Access ------------------------------------------------------------------------

# Who may sign in until you change it on the Admin page:
#   servers   = Plex users with access to a server the admin approved (default)
#   allowlist = only listed Plex usernames / emails
#   open      = any Plex account
ACCESS_MODE=servers
# Plex username or email that may claim the admin role. Strongly recommended if this
# instance is reachable from the internet before you've signed in for the first time.
INITIAL_ADMIN=

# --- Optional ----------------------------------------------------------------------

PLEKSTENDER_PORT=8080
TZ=UTC
LOG_LEVEL=INFO
POSTGRES_USER=plekstender
POSTGRES_DB=plekstender
# Behind a reverse proxy, trust its X-Forwarded-For header (IP/CIDR list, or * if the
# app port isn't reachable except through the proxy).
FORWARDED_ALLOW_IPS=127.0.0.1

# Last.fm API key for importing listening history (https://www.last.fm/api/account/create).
# Can also be set by an admin on Settings -> Listening. From 1 Dec 2026 a key only works
# while its owner has Last.fm Pro.
LASTFM_API_KEY=

# Artist artwork: fanart.tv API key (https://fanart.tv/get-an-api-key/). Can also be set
# by an admin on Settings -> Library.
FANART_API_KEY=

# Identifying music files by sound: an AcoustID application key
# (https://acoustid.org/new-application). Can also be set by an admin on Settings -> Services.
ACOUSTID_API_KEY=

# Live (upcoming shows): a JamBase Data API key (jbd_..., free Developer plan for
# non-commercial use at https://data.jambase.com). Can also be set by an admin on
# Settings -> Services. Requests past the plan's 1,000 a month are billed, so
# Plekstender stops at its own monthly cap.
JAMBASE_API_KEY=
# JAMBASE_MONTHLY_CAP=900

# Live's second source: a Ticketmaster Discovery API Consumer Key (free app at
# https://developer.ticketmaster.com, 5,000 requests a day). Can also be set on
# Settings -> Services.
TICKETMASTER_API_KEY=
# TICKETMASTER_DAILY_CAP=4000

# Gigs gone to: a setlist.fm API key (https://www.setlist.fm/settings/api, non-commercial)
# to import the concerts people marked as attended. Also on Settings -> Services.
SETLISTFM_API_KEY=

# Playlist imports from Spotify links: a Spotify app's client ID and secret
# (https://developer.spotify.com/dashboard). Also on Settings -> Services.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Image search for artist logos: SearXNG from the `search` profile below.
# SEARXNG_URL=http://searxng:8080

# Image search profile (`docker compose --profile search up -d`)
# Generate with: openssl rand -hex 32
SEARXNG_SECRET=

# Traefik (bundled via `--profile traefik`, or your own; see compose.override.example.yaml)
TRAEFIK_ENABLE=false
PLEKSTENDER_HOST=plekstender.example.com
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
TRAEFIK_ACME_EMAIL=

# --- Image ---------------------------------------------------------------------------
# By default the image is built from this checkout. To run the published image instead:
# PLEKSTENDER_IMAGE=ghcr.io/joakimkingstrom/plekstender:latest
# PLEKSTENDER_PULL_POLICY=always
