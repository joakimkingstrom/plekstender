{
  "name": "plekstender-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "preview": "vite preview",
    "gen:api": "cd ../backend && uv run plekstender openapi > openapi.json && cd ../frontend && npx -y openapi-typescript@7.13.0 ../backend/openapi.json -o src/api/schema.d.ts",
    "brand:sync": "cp ../branding/favicon.svg ../branding/favicon.ico ../branding/plekstender-loader.svg ../branding/icons/apple-touch-icon.png ../branding/icons/icon-192.png ../branding/icons/icon-512.png ../branding/icons/icon-maskable-512.png public/brand/"
  },
  "dependencies": {
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@tanstack/react-query": "^5.108.0",
    "d3-geo": "3.1.1",
    "maplibre-gl": "6.16.0",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "supercluster": "9.1.0",
    "topojson-client": "3.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/d3-geo": "3.1.0",
    "@types/geojson": "7946.0.16",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/topojson-client": "3.1.5",
    "@types/topojson-specification": "1.0.5",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^31.0.1",
    "oxlint": "^1.90.0",
    "tailwindcss": "^4.3.5",
    "topojson-server": "3.0.1",
    "topojson-simplify": "3.0.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
